// Zone-Chrétien Media — Schéma Prisma complet
// Base de données : Turso (libSQL, compatible SQLite) — voir CORRECTION 1 du cahier des charges.
// Le provider reste "sqlite" (libSQL est un fork compatible SQLite). Depuis Prisma 7, l'URL de
// connexion et le driver adapter (@prisma/adapter-libsql) ne se déclarent plus ici : ils sont
// configurés dans prisma.config.ts (Migrate) et dans le constructeur PrismaClient (runtime),
// mis en place à l'étape 2 (Config Turso + migration initiale).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum PrayerCategory {
  MORNING
  MIDDAY
  EVENING
  FAMILY
  HEALING
  PROTECTION
}

enum BannerType {
  ADSENSE
  ARTIST_SPONSOR
  EVENT_SPONSOR
  PARTNER_BANNER
}

enum ContentType {
  SONG
  ARTICLE
  ARTIST
  VIDEO
  INSPIRATION
  DEVOTION
  PRAYER
  VERSE
  TESTIMONY
  RESOURCE
}

// Détermine comment interpréter Song.audioUrl et quel lecteur afficher côté public.
// FICHIER_DIRECT nécessite l'autorisation explicite de l'artiste (le fichier est
// hébergé pour être diffusé) — les trois autres intègrent le lecteur officiel de la
// plateforme où l'artiste a lui-même publié le morceau (aucun fichier hébergé ici).
enum SourceType {
  FICHIER_DIRECT
  SOUNDCLOUD
  AUDIOMACK
  YOUTUBE_MUSIC
}

// Détermine quel champ de saisie afficher dans le CMS pour `Resource.fileUrl`
// (PDF, audio ou YouTube) et comment la page publique doit traiter le lien —
// sauf CONFERENCE/COURSE, dont le média n'est pas fixe : la page publique
// détecte alors dynamiquement s'il s'agit d'un lien YouTube ou d'un document.
enum ResourceType {
  BOOK // Livre — PDF
  BIBLE_STUDY // Étude biblique — PDF
  AUDIO_SERMON // Prédication audio — URL audio
  VIDEO_SERMON // Prédication vidéo — URL YouTube
  CONFERENCE // Conférence — PDF ou YouTube selon l'URL fournie
  COURSE // Cours — PDF ou YouTube selon l'URL fournie
}

enum AIProvider {
  GEMINI
  OLLAMA
}

// ============================================================================
// AUTHENTIFICATION (NextAuth / Auth.js) — CMS Administrateur
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String? // hash bcrypt — connexion email + mot de passe
  emailVerified DateTime?
  image         String?
  role          Role      @default(EDITOR)
  active        Boolean   @default(true) // compte désactivé = connexion refusée (voir auth.ts)

  accounts Account[]
  sessions Session[]
  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// TAXONOMIE PARTAGÉE
// ============================================================================

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  type        ContentType
  description String?

  songs        Song[]
  articles     Article[]
  videos       Video[]
  inspirations Inspiration[]
  resources    Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  songs     Song[]
  articles  Article[]
  artists   Artist[]
  resources Resource[]

  createdAt DateTime @default(now())

  @@map("tags")
}

// ============================================================================
// ARTISTES & CHANSONS
// ============================================================================

model Artist {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  photoUrl     String?
  role         String? // titre court (ex. "Artiste gospel", "Évangéliste & Chanteur")
  bio          String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  tiktokUrl    String?
  twitterUrl   String?
  isSponsored  Boolean @default(false)

  // Contact direct pour le CMS (droits/autorisations) — jamais affiché publiquement.
  whatsappNumber String?
  email          String?

  songs  Song[]
  videos Video[]
  tags   Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("artists")
}

model Song {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  lyrics      String?
  imageUrl    String
  audioUrl    String? // sens dépend de sourceType : fichier direct, ou URL d'intégration SoundCloud/Audiomack/YouTube Music
  sourceType  SourceType @default(FICHIER_DIRECT)
  youtubeUrl  String? // clip vidéo officiel — indépendant de sourceType/audioUrl

  artistId   String
  artist     Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?      @relation(fields: [categoryId], references: [id])
  tags       Tag[]
  playlists  PlaylistSong[]

  metaTitle       String?
  metaDescription String?

  publishedAt DateTime? // date affichée publiquement, choisie par l'éditeur — repli sur createdAt si non renseignée
  views       Int       @default(0)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("songs")
}

// ============================================================================
// PLAYLISTS ÉDITORIALES
// ============================================================================

model Playlist {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  imageUrl    String?

  order     Int     @default(0)
  published Boolean @default(false)

  metaTitle       String?
  metaDescription String?

  publishedAt DateTime? // date affichée publiquement, choisie par l'éditeur — repli sur createdAt si non renseignée

  songs PlaylistSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("playlists")
}

// Table de liaison explicite (plutôt qu'un m2m implicite Prisma) pour porter
// la position de chaque chanson au sein d'une playlist — nécessaire pour le
// réordonnancement dans le CMS et la lecture en séquence côté public.
model PlaylistSong {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@unique([playlistId, songId])
  @@index([playlistId, position])
  @@map("playlist_songs")
}

// ============================================================================
// VIDÉOS
// ============================================================================

model Video {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  description  String?
  youtubeUrl   String
  thumbnailUrl String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  artistId   String?
  artist     Artist?   @relation(fields: [artistId], references: [id])

  publishedAt DateTime? // date affichée publiquement, choisie par l'éditeur — repli sur createdAt si non renseignée
  views       Int       @default(0)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("videos")
}

// ============================================================================
// INSPIRATIONS
// ============================================================================

model Inspiration {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  content  String
  imageUrl String?
  videoUrl String? // URL YouTube optionnelle — vidéo d'accompagnement (voir Song.youtubeUrl)
  author   String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  publishedAt DateTime? // date affichée publiquement, choisie par l'éditeur — repli sur createdAt si non renseignée
  views       Int       @default(0)
  published   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("inspirations")
}

// ============================================================================
// DÉVOTIONS
// ============================================================================

model Devotion {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  mainVerseRef  String
  mainVerseText String
  reflection    String
  application   String
  prayer        String
  imageUrl      String?
  date          DateTime @default(now())

  views     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
  @@map("devotions")
}

// ============================================================================
// PRIÈRES
// ============================================================================

model Prayer {
  id       String         @id @default(cuid())
  title    String
  slug     String         @unique
  content  String
  category PrayerCategory
  imageUrl String?

  publishedAt DateTime? // date affichée publiquement, choisie par l'éditeur — repli sur createdAt si non renseignée
  views       Int       @default(0)
  published   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, category])
  @@map("prayers")
}

// ============================================================================
// VERSET DU JOUR
// ============================================================================

model Verse {
  id          String   @id @default(cuid())
  reference   String
  text        String
  explanation String?
  imageUrl    String?
  date        DateTime @unique

  views     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
  @@map("verses")
}

// ============================================================================
// TÉMOIGNAGES
// ============================================================================

model Testimony {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  content    String
  authorName String
  imageUrl   String?

  publishedAt DateTime? // date affichée publiquement, choisie par l'éditeur — repli sur createdAt si non renseignée
  views       Int       @default(0)
  published   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("testimonies")
}

// ============================================================================
// BLOG CHRÉTIEN (ARTICLES)
// ============================================================================

model Article {
  id            String  @id @default(cuid())
  title         String
  slug          String  @unique
  excerpt       String?
  content       String // HTML éditeur riche
  coverImageUrl String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tags       Tag[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  metaTitle       String?
  metaDescription String?

  views       Int       @default(0)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("articles")
}

// ============================================================================
// BIBLIOTHÈQUE NUMÉRIQUE (livres, études, prédications, conférences, cours)
// ============================================================================
// `fileUrl` pointe toujours vers une source externe gratuite (GitHub Releases,
// Google Drive en partage public, etc.) — comme Song.audioUrl, le site
// n'héberge aucun fichier lourd (contrainte "0 coût" du projet).

model Resource {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String? // markdown, comme Inspiration.content / Devotion.content
  author        String?
  type          ResourceType
  fileUrl       String
  coverImageUrl String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tags       Tag[]

  views       Int       @default(0)
  downloads   Int       @default(0)
  published   Boolean   @default(true)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("resources")
}

// ============================================================================
// BIBLE (texte intégral, importé depuis Lepolo_Bible — voir scripts/bible/)
// ============================================================================
// Préfixées "Bible" pour éviter toute collision avec le modèle `Verse`
// existant plus haut (qui sert au "verset du jour", contenu éditorial saisi
// à la main — sans rapport avec ces données bibliques complètes).
// Identifiants entiers auto-incrémentés (plutôt que cuid, convention du
// reste du schéma) : ça reproduit le rowid SQLite déjà utilisé par la table
// FTS5 source (voir migration.sql pour bible_verses_fts), et facilite le
// mapping direct lors de l'import.

enum BibleTestament {
  AT
  NT
}

model BibleVersion {
  id       Int     @id @default(autoincrement())
  code     String  @unique // ex. "LSG1910"
  name     String // ex. "Louis Segond 1910"
  language String  @default("fr")
  license  String? // ex. "domaine public"

  books BibleBook[]

  createdAt DateTime @default(now())

  @@map("bible_versions")
}

model BibleBook {
  id           Int            @id @default(autoincrement())
  versionId    Int
  version      BibleVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  testament    BibleTestament
  order        Int // ordre canonique 1..66
  name         String // ex. "Genèse"
  slug         String // ex. "genese"
  abbreviation String // ex. "Gen"
  chapterCount Int

  chapters BibleChapter[]

  @@unique([versionId, order])
  @@unique([versionId, slug])
  @@index([versionId, testament])
  @@map("bible_books")
}

model BibleChapter {
  id         Int       @id @default(autoincrement())
  bookId     Int
  book       BibleBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number     Int
  verseCount Int

  verses BibleVerse[]

  @@unique([bookId, number])
  @@map("bible_chapters")
}

model BibleVerse {
  id        Int          @id @default(autoincrement())
  chapterId Int
  chapter   BibleChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number    Int
  text      String

  @@unique([chapterId, number])
  @@map("bible_verses")
}

// ============================================================================
// STATISTIQUES DE VUES (tableau de bord, stats mensuelles)
// ============================================================================

model ViewLog {
  id          String      @id @default(cuid())
  contentType ContentType
  contentId   String
  viewedAt    DateTime    @default(now())

  @@index([contentType, contentId])
  @@index([viewedAt])
  @@map("view_logs")
}

// ============================================================================
// MONÉTISATION — zones configurables
// ============================================================================

model Banner {
  id              String     @id @default(cuid())
  type            BannerType
  title           String
  imageUrl        String?
  linkUrl         String?
  adsenseSlotCode String? // code AdSense brut (<ins> / script), collé tel quel
  position        String? // ex: "sidebar", "header", "in-content"
  active          Boolean    @default(true)
  startDate       DateTime?
  endDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

// ============================================================================
// MODÉRATION — SIGNALEMENTS DE RETRAIT
// ============================================================================

enum TakedownStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// Formulaire public "signaler un problème" (droits d'auteur, retrait…). contentType/
// contentId/contentTitle/contentUrl sont dénormalisés au moment de l'envoi (pas de
// relation Prisma) : le contenu visé peut appartenir à plusieurs modèles différents
// (Song, Video, Inspiration…), et on veut garder trace du titre/lien même si le
// contenu est ensuite supprimé. Champs nullable : un signalement peut aussi arriver
// sans contexte précis (accès direct à /signaler).
model TakedownReport {
  id             String @id @default(cuid())
  requesterName  String
  requesterEmail String
  message        String

  contentType  ContentType?
  contentId    String?
  contentTitle String?
  contentUrl   String?

  status TakedownStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("takedown_reports")
}

// ============================================================================
// NEWSLETTER
// ============================================================================

model NewsletterSubscriber {
  id        String  @id @default(cuid())
  email     String  @unique
  firstName String?

  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ============================================================================
// PARAMÈTRES DU SITE (singleton)
// ============================================================================

model Settings {
  id String @id @default("settings")

  siteName        String  @default("Zone-Chrétien Media")
  siteDescription String  @default("La musique, l'inspiration et la Parole pour édifier les nations.")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String  @default("#0B1E3D")
  accentColor     String  @default("#D4AF37")

  facebookUrl    String?
  youtubeUrl     String?
  instagramUrl   String?
  tiktokUrl      String?
  whatsappNumber String?
  contactEmail   String?

  adsenseClientId String?

  aiProvider AIProvider @default(GEMINI)

  maintenanceMode Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("settings")
}
